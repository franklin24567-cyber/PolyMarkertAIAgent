# Database (local SQLite file path). On Vercel this filesystem is ephemeral -
# see README "Production Notes" for using Turso/Neon in production instead.
DATABASE_URL=./polymarket-bot.db

# Polymarket public API bases (read-only, no auth required)
POLYMARKET_API_BASE=https://data-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com

# Optional: Telegram notifications for the daily report. Leave blank to
# disable - scripts gracefully skip sending if either is unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard branding
NEXT_PUBLIC_APP_NAME=PolyMarket AI Agent
